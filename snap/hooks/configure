#!/bin/sh
# Validate `snap set miniserve ...` and restart the service if it is running.
set -eu

case "$(snapctl get port)" in
  '' | *[!0-9]*)
    echo "port must be a number" >&2
    exit 1
    ;;
esac

case "$(snapctl get upload)" in
  true | false) ;;
  *)
    echo "upload must be true or false" >&2
    exit 1
    ;;
esac

if snapctl services "$SNAP_INSTANCE_NAME.daemon" | grep -qw active; then
  snapctl restart "$SNAP_INSTANCE_NAME.daemon"
fi
