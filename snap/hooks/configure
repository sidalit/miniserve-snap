#!/bin/sh
# Validate `snap set miniserve ...` and restart the service if it is enabled or running.
set -eu

port="$(snapctl get port)"
case "$port" in
  '' | *[!0-9]*)
    echo "port must be a number" >&2
    exit 1
    ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo "port must be between 1 and 65535" >&2
  exit 1
fi

case "$(snapctl get interfaces)" in
  '' | *[!0-9A-Fa-f.:]*)
    echo "interfaces must be a single IPv4 or IPv6 address" >&2
    exit 1
    ;;
esac

case "$(snapctl get auth)" in
  '' | ?*:?*) ;;
  *)
    echo "auth must be username:password, username:sha256:hash or username:sha512:hash" >&2
    exit 1
    ;;
esac

case "$(snapctl get upload)" in
  true | false) ;;
  *)
    echo "upload must be true or false" >&2
    exit 1
    ;;
esac

# Also restart an enabled service that is down, so fixing a bad value brings it back.
if snapctl services "$SNAP_INSTANCE_NAME.daemon" | grep -qwE 'enabled|active'; then
  snapctl restart "$SNAP_INSTANCE_NAME.daemon"
fi
